# Google Maps JavaScript API キー
# 取得: https://console.cloud.google.com/ → Maps JavaScript API + Directions/Routes を有効化
# NEXT_PUBLIC_ が付く変数はブラウザに露出するため、Google Cloud側で
# 「HTTPリファラー制限」を必ず設定すること（本番ドメイン + localhost）。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_api_key_here

# 地図のMap ID（Advanced Markers / カスタムスタイルを使う場合に必要）
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_map_id_here

# 外部のライフハックアプリ（既存）へのリンク先
NEXT_PUBLIC_LIFEHACK_APP_URL=https://example.com

# ---- Supabase（施設ピンの保存先） ----
# Supabaseプロジェクトの Settings → API から取得。
# URL と anon key はブラウザ公開（読み取り専用・RLSで保護）。
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# service_role キーは絶対に公開しない（サーバーの書き込み専用）。
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---- 管理者画面のパスワード（サーバー側で照合） ----
ADMIN_PASSWORD=7294351
